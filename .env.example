# Database
POSTGRES_USER=cangzhi
POSTGRES_PASSWORD=cangzhi-dev
POSTGRES_DB=cangzhi
POSTGRES_PORT=5432
DATABASE_URL=postgresql://cangzhi:cangzhi-dev@localhost:5432/cangzhi

# AI 理解（默认留空：不调用模型，资料仍会入库并进入“待整理”）
# AI_PROVIDER=openai
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_MODEL=gpt-4o-mini

# 或使用 Ollama
# AI_PROVIDER=ollama
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=llama3.1

# 网页采集安全上限
URL_FETCH_MAX_BYTES=5242880
URL_FETCH_TIMEOUT_SECONDS=20
URL_FETCH_MAX_REDIRECTS=5

# Storage
STORAGE_PATH=./storage
MAX_UPLOAD_SIZE_MB=50

# Worker
POLL_INTERVAL=5

# Logging
LOG_LEVEL=info

# Local ports
API_PORT=8000
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
# 通过局域网 IP 使用时，把访问藏知的主机名或 IP 加到这里（逗号分隔）
ALLOWED_DEV_ORIGINS=localhost,127.0.0.1,192.168.50.136
