# Database
POSTGRES_USER=cangzhi
# Compose 会把密码插入数据库 URL；请使用字母、数字、下划线或连字符
POSTGRES_PASSWORD=cangzhi-dev
POSTGRES_DB=cangzhi
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432
# 仅供不使用 Compose 的本地开发；Compose 会按上面三项生成容器内连接地址
DATABASE_URL=postgresql://cangzhi:cangzhi-dev@localhost:5432/cangzhi

# AI 理解（默认留空：不调用模型，资料仍会入库并进入“待整理”）
# AI_PROVIDER=openai
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_MODEL=gpt-4o-mini
AI_REQUEST_TIMEOUT_SECONDS=30
AI_PROMPT_VERSION=v1

# 或使用 Ollama
# AI_PROVIDER=ollama
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=llama3.1

# 网页采集安全上限
URL_FETCH_MAX_BYTES=5242880
URL_FETCH_TIMEOUT_SECONDS=20
URL_FETCH_MAX_REDIRECTS=5

# Storage
STORAGE_HOST_PATH=./storage
MAX_UPLOAD_SIZE_MB=50

# 结构化数据集执行边界
DATASET_QUERY_MEMORY_LIMIT=512MB
DATASET_QUERY_THREADS=2
DATASET_QUERY_TIMEOUT_SECONDS=20

# Worker
POLL_INTERVAL=5

# Logging
LOG_LEVEL=info

# 扫描 PDF OCR 兜底：仅 Worker 容器生效（tesseract + pypdfium2）
# 当 PDF 页内可复制字符数 < PDF_OCR_MIN_NATIVE_CHARS 且包含图片时，
# 按页渲染并送 tesseract 识别；已有的少量原生文字仍会保留。
# 关闭或缺依赖时仍能完成基础解析，原生文字页不受影响。
# 多语言：tesseract 训练数据以 `+` 连接，例如 chi_sim+eng。
# 渲染 DPI 越高识别越准但越慢；页数上限只计算 OCR 候选页。
PDF_OCR_ENABLED=true
PDF_OCR_LANGUAGE=chi_sim+eng
PDF_OCR_DPI=180
PDF_OCR_MIN_NATIVE_CHARS=24
PDF_OCR_MAX_PAGES=300
PDF_OCR_TIMEOUT_SECONDS=30

# Local ports
API_BIND_ADDRESS=0.0.0.0
API_PORT=8000
WEB_BIND_ADDRESS=0.0.0.0
WEB_PORT=3000
# API 跨域白名单；同源 Web、CLI、MCP 通常无需填写
CORS_ALLOWED_ORIGINS=

# 加密主密钥：留空时 API 启动会自动在 storage/.secret_key 生成
# 0o600 权限的文件；显式设置时必须是 32 字节 url-safe base64 的 Fernet 密钥
# CANGZHI_SECRET_KEY=

# Web 子路径网关（可选，默认留空即根路径部署）
# 设置后 Next.js 会把 Web 挂到该子路径，例如 `/_cangzhi`。
# 重要：该值在镜像构建时固化，修改后必须执行：
#   docker compose build web && docker compose up -d web
# 健康地址：根路径 -> /api/health；子路径 -> <CANGZHI_WEB_BASE_PATH>/api/health
# CANGZHI_WEB_BASE_PATH=
