# Database
POSTGRES_USER=cangzhi
# Compose 会把密码插入数据库 URL；请使用字母、数字、下划线或连字符
POSTGRES_PASSWORD=cangzhi-dev
POSTGRES_DB=cangzhi
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432
# 仅供不使用 Compose 的本地开发；Compose 会按上面三项生成容器内连接地址
DATABASE_URL=postgresql://cangzhi:cangzhi-dev@localhost:5432/cangzhi

# AI 理解（默认留空：不调用模型，资料仍会入库并进入“待整理”）
# AI_PROVIDER=openai
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_MODEL=gpt-4o-mini
AI_REQUEST_TIMEOUT_SECONDS=30
AI_PROMPT_VERSION=v1

# 或使用 Ollama
# AI_PROVIDER=ollama
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=llama3.1

# 网页采集安全上限
URL_FETCH_MAX_BYTES=5242880
URL_FETCH_TIMEOUT_SECONDS=20
URL_FETCH_MAX_REDIRECTS=5

# Storage
STORAGE_HOST_PATH=./storage
MAX_UPLOAD_SIZE_MB=50

# 结构化数据集执行边界
DATASET_QUERY_MEMORY_LIMIT=512MB
DATASET_QUERY_THREADS=2
DATASET_QUERY_TIMEOUT_SECONDS=20

# Worker
POLL_INTERVAL=5

# Logging
LOG_LEVEL=info

# Local ports
API_BIND_ADDRESS=0.0.0.0
API_PORT=8000
WEB_BIND_ADDRESS=0.0.0.0
WEB_PORT=3000
# API 跨域白名单；同源 Web、CLI、MCP 通常无需填写
CORS_ALLOWED_ORIGINS=

# 加密主密钥：留空时 API 启动会自动在 storage/.secret_key 生成
# 0o600 权限的文件；显式设置时必须是 32 字节 url-safe base64 的 Fernet 密钥
# CANGZHI_SECRET_KEY=
